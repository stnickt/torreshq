# Copy this file to .env on the Pi (never commit the real .env) and fill in real values.

# Gmail account used to send outgoing mail. Requires a Google App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords),
# not your normal Gmail password.
SMTP_USER=your-sending-account@gmail.com
SMTP_PASS=your-16-character-app-password

# Address that receives the access request emails. Defaults to SMTP_USER if unset.
TO_EMAIL=stnickt@gmail.com
