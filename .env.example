# Copy this file to .env on the Pi (never commit the real .env) and fill in real values.

# Gmail account used to send outgoing mail. Requires a Google App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords),
# not your normal Gmail password.
SMTP_USER=your-sending-account@gmail.com
SMTP_PASS=your-16-character-app-password

# Address that receives the access request emails. Defaults to SMTP_USER if unset.
TO_EMAIL=stnickt@gmail.com

# Public URL the accept/deny email links point back to (no trailing slash).
PUBLIC_BASE_URL=https://torreshq.com

# RCON connection to the Minecraft server (Mac mini), used so clicking "Accept"
# in the email can run "whitelist add <username>" automatically. Enable RCON
# in the server's server.properties: enable-rcon=true, rcon.port=25575,
# rcon.password=<same value as below>. Leave these unset to skip automation —
# Accept will still record the decision, but you'll need to whitelist manually.
RCON_HOST=<mac-mini-lan-ip-or-hostname>
RCON_PORT=25575
RCON_PASSWORD=your-rcon-password
